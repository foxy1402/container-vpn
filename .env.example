# Copy this file to .env and fill in strong, unique random values.
# .env is loaded automatically by docker compose; keep it out of git
# (chmod 600 .env). Every variable below is REQUIRED by docker-compose-gost.yml
# — deployment fails fast with a clear error if one is missing.
#
# Generate strong values, e.g.:
#   openssl rand -base64 24

# SOCKS5 proxy credentials
SOCKS5_USER=
SOCKS5_PASS=

# HTTP proxy credentials
HTTP_PROXY_USER=
HTTP_PROXY_PASS=

# GOST multi-protocol proxy credentials + Shadowsocks key
GOST_USER=
GOST_PASS=
GOST_SS_KEY=

# Metrics Gateway bearer token (UUID or long random string)
SERVICE_TOKEN=
