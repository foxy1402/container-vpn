FROM debian:13-slim AS xray-downloader

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        unzip && \
    rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
RUN case "$TARGETARCH" in \
        amd64) XRAY_ARCH="64" ;; \
        arm64) XRAY_ARCH="arm64-v8a" ;; \
        *) echo "Unsupported TARGETARCH: $TARGETARCH" && exit 1 ;; \
    esac && \
    wget -qO /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${XRAY_ARCH}.zip" && \
    unzip -q /tmp/xray.zip -d /tmp/xray && \
    install -m 0755 /tmp/xray/xray /usr/local/bin/xray && \
    rm -rf /tmp/xray /tmp/xray.zip

# ── Final minimal image ──────────────────────────────────────────────────────
FROM debian:13-slim

LABEL org.opencontainers.image.title="WSGOST VLESS/Trojan over WebSocket"
LABEL org.opencontainers.image.description="VLESS/Trojan-over-WebSocket proxy (Xray-core) for platforms that only expose HTTP/HTTPS."
LABEL org.opencontainers.image.version="2.0.0"
LABEL org.opencontainers.image.authors="CloudProxy"
LABEL service.type="wsgost"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

COPY --from=xray-downloader /usr/local/bin/xray /usr/local/bin/xray
COPY wsgost-start.sh /app/wsgost-start.sh
COPY wsgost-healthcheck.sh /app/wsgost-healthcheck.sh

RUN chmod +x /usr/local/bin/xray /app/wsgost-start.sh /app/wsgost-healthcheck.sh && \
    useradd -r -u 1000 -s /bin/false appuser && \
    chown -R appuser:appuser /app

ENV WS_PROTOCOL=vless \
    WS_HOST=0.0.0.0 \
    WS_PORT=8080 \
    WS_PATH=/ws \
    VLESS_UUID= \
    TROJAN_PASSWORD= \
    XRAY_LOG_LEVEL=warning

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD /app/wsgost-healthcheck.sh || exit 1

USER appuser

CMD ["/app/wsgost-start.sh"]
